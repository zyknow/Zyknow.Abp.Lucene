<Project>
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Version>11.0.0-preview.1</Version>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <AbpProjectType>app</AbpProjectType>
        <AbpVersion>11.0.0</AbpVersion>
        <DotNetPackageVersion>11.0.0</DotNetPackageVersion>
        <LuceneVersion>4.8.0-beta00018</LuceneVersion>
    </PropertyGroup>

    <Target Name="NoWarnOnRazorViewImportedTypeConflicts" BeforeTargets="RazorCoreCompile">
        <PropertyGroup>
            <NoWarn>$(NoWarn);0436</NoWarn>
        </PropertyGroup>
    </Target>

    <!-- 统一导入 NuGet 包元数据配置 -->
    <Import Project="$(MSBuildThisFileDirectory)nuget.props" />
</Project>